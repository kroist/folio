{
  "name": "folio-markdown-editor",
  "version": "1.0.0",
  "type": "module",
  "description": "A calm, local-first Markdown workspace for macOS.",
  "license": "MIT",
  "author": "Maksym Zub",
  "homepage": "https://github.com/kroist/folio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kroist/folio.git"
  },
  "bugs": {
    "url": "https://github.com/kroist/folio/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@hono/node-server": "2.1.0"
  },
  "productName": "Folio",
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "com.folio.markdown-editor",
    "productName": "Folio",
    "artifactName": "Folio-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "asar": false,
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime/node",
        "to": "runtime/node"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Folio ${version}",
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 420,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && node scripts/run-dev-electron.mjs",
    "build:electron": "esbuild electron/main.ts electron/preload.ts electron/qmd-worker.ts electron/mcp-server.ts --bundle --platform=node --format=cjs --external:electron --external:@tobilu/qmd --outdir=dist-electron --out-extension:.js=.cjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "prepare:runtime": "node scripts/prepare-node-runtime.mjs",
    "package:mac": "npm run build && npm run prepare:runtime && electron-builder --mac --publish never",
    "package:mac:dir": "npm run build && npm run prepare:runtime && electron-builder --mac dir --publish never",
    "smoke:package:mac": "node scripts/smoke-packaged-search.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint .",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tobilu/qmd": "^2.5.3",
    "@uiw/react-codemirror": "^4.25.11",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.1",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.3"
  }
}
